# Better Auth Configuration
# Local development
BETTER_AUTH_URL=http://localhost:3000
VITE_BETTER_AUTH_URL=http://localhost:3000

# GitHub OAuth (create an OAuth App for local dev or use dummy values if not testing login)
GITHUB_CLIENT_ID=your-local-github-client-id
GITHUB_CLIENT_SECRET=your-local-github-client-secret

# Better Auth secret (generate a random 32-byte value)
BETTER_AUTH_SECRET=replace-with-dev-secret

# Production (do not commit real values; use .env-prod via `source .env-prod`)
# BETTER_AUTH_URL=https://your-cloudfront-domain.cloudfront.net
# VITE_BETTER_AUTH_URL=https://your-cloudfront-domain.cloudfront.net
# GITHUB_CLIENT_ID=...
# GITHUB_CLIENT_SECRET=...
